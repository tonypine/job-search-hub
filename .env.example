# Copy to .env and fill in. .env is never committed.

# Password for the `hub` Postgres role. Any long random string: openssl rand -hex 24
HUB_DATABASE_PASSWORD=

# Bearer token for you (the owner): Claude Code's MCP registration and the hub CLI use it.
# openssl rand -hex 32
HUB_OWNER_TOKEN=

# How often hub-server reads watched companies' job boards (a Go duration). 0 turns it off.
# HUB_BOARD_POLL_INTERVAL=1h

# How often hub-server searches job feeds (Himalayas) by the job criteria's search terms. 0 turns it off.
# HUB_FEED_POLL_INTERVAL=3h

# The model that reads each job's key facts, through an OpenAI-compatible chat-completions API.
# Defaults to LM Studio on the host (http://host.docker.internal:1234/v1) with qwen/qwen3.5-9b;
# set HUB_JOB_FACTS_MODEL_URL= (empty) to turn reading off.
# HUB_JOB_FACTS_MODEL_URL=http://host.docker.internal:1234/v1
# HUB_JOB_FACTS_MODEL=qwen/qwen3.5-9b
# HUB_JOB_FACTS_INTERVAL=10m

# Google (Gmail and Calendar read-only, and Pub/Sub to hear new mail): the OAuth client JSON Google issues for a "Desktop app",
# kept in HUB_CONFIG_DIR (default ~/.config/job-search-hub) as google-oauth-client.json.
# HUB_CONFIG_DIR=

# The agents' prompts live in the database, never in the repo. A fresh database takes each prompt's
# first version from HUB_CONFIG_DIR/agent-prompts: <kind>.md, plus <kind>.schema.json when the
# prompt has a result schema. Empty turns seeding off.
# HUB_AGENT_PROMPTS_DIR=/config/agent-prompts
# HUB_PUBLIC_URL=http://localhost:8090

# Gmail announces mailbox changes to a Pub/Sub topic, and the hub reads them from a pull
# subscription with the same Google sign-in. Give gmail-api-push@system.gserviceaccount.com the
# Pub/Sub Publisher role on the topic. Both empty leaves it off.
# HUB_GMAIL_PUBSUB_TOPIC=projects/<project>/topics/gmail-changes
# HUB_GMAIL_PUBSUB_SUBSCRIPTION=projects/<project>/subscriptions/gmail-changes-sub

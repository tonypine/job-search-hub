<?xml version="1.0" encoding="utf-8"?>
<!-- The hub is reached over HTTPS through Tailscale. Plain HTTP is allowed only to the
     emulator's address for the Mac it runs on, for development. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

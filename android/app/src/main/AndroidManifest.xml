<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Whether the network is Wi-Fi, which new versions download on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The app installs its own new versions through PackageInstaller; Android asks the owner to allow it once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12 and later then update the app without asking again, once the installed version declares it. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".HubApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.JobSearchHub">
        <!-- Any size and orientation: a phone, an unfolded Fold, a tablet, split screen and pop-up view.
             Compose redraws for a new size itself, so folding, rotating and resizing keep the open job
             and its scroll position instead of recreating the activity and reloading it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A pairing link opened on the phone pairs it, like the QR code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jobsearchhub" android:host="pair" />
            </intent-filter>
        </activity>
        <service
            android:name=".push.HubMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- A notification's buttons, like Followed up and Snooze a day. -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />
        <!-- Android's installer reporting on an update the app handed it. -->
        <receiver
            android:name=".versions.InstallResultReceiver"
            android:exported="false" />
        <!-- Opens the app again once it has replaced itself with a new version. -->
        <receiver
            android:name=".versions.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
